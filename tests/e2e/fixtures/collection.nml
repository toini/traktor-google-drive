<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Fixture collection for e2e tests. Shapes here are load-bearing — see
  traktor-nml-parser's Track.FromXml / Playlist.FromXml:

    Track.Path   = DIR + FILE, then "Macintosh HD/" removed, ALL ":" removed,
                   leading "/" trimmed.
    PRIMARYKEY   = same normalization; must match Track.Path exactly or the
                   playlist entry is silently dropped.
    $ROOT        = required, and Collection.FromXml does .Single() on it.
    Paths containing "silent" are filtered out by the parser, and so is any
    entry without a FILE (streaming) and any key on a volume other than
    "Macintosh HD". Playlist.Tracks silently drops all of those; the app
    reads every ENTRY itself (Models/PlaylistEntry.cs), and the "Gig Night"
    playlist below has one of each. Don't use "silent" elsewhere.

    INFO attributes as Traktor writes them: RATING is the free-text "Comment 2"
    column (NOT stars, those are RANKING 0-255), and COLOR is the track color,
    1 red .. 7 magenta. RANKING is 51 per star, 0 = unrated; Traktor only writes
    multiples of 51, so the 60 below is a rounding probe. The release is the
    ALBUM element's TITLE. The app reads COLOR, RANKING and ALBUM itself; the
    parser does not.

    TEMPO BPM is a float as Traktor writes it (128.000061, not 128); the parser
    reads it as Track.Bpm. The Sets/ entries cover the BPM column's rounding
    (-> 128, 127.5, 142) and the Archive/ alpha.wav has no TEMPO at all, so it
    probes the blank cell and missing-last sort.

  So DIR="/:Music/:Sets/:" FILE="alpha.wav" -> "Music/Sets/alpha.wav".
-->
<NML VERSION="19">
  <HEAD COMPANY="www.native-instruments.com" PROGRAM="Traktor"></HEAD>
  <MUSICFOLDERS></MUSICFOLDERS>
  <COLLECTION ENTRIES="17">

    <ENTRY MODIFIED_DATE="2024/3/17" TITLE="Alpha Drift" ARTIST="Test Artist One">
      <LOCATION DIR="/:Music/:Sets/:" FILE="alpha.wav" VOLUME="Macintosh HD"></LOCATION>
      <ALBUM TITLE="Fixture Album"></ALBUM>
      <INFO BITRATE="1411000" GENRE="Psytech" LABEL="Fixture Label" COMMENT="first track"
            PLAYTIME="245" PLAYTIME_FLOAT="245.5" RATING="peak 2:10" RANKING="255" KEY="8A" IMPORT_DATE="2023/3/12" COLOR="1"></INFO>
      <TEMPO BPM="128.000061" BPM_QUALITY="100.000000"></TEMPO>
    </ENTRY>

    <ENTRY MODIFIED_DATE="2024/3/17" TITLE="Beta Pulse" ARTIST="Test Artist Two">
      <LOCATION DIR="/:Music/:Sets/:" FILE="beta.wav" VOLUME="Macintosh HD"></LOCATION>
      <ALBUM TRACK="2" TITLE="Another Release"></ALBUM>
      <INFO BITRATE="1411000" GENRE="Psytech" LABEL="Fixture Label" COMMENT="second track"
            PLAYTIME="312" PLAYTIME_FLOAT="312.0" RATING="build 4:17" RANKING="204" KEY="9A" IMPORT_DATE="2023/10/10" COLOR="5"></INFO>
      <TEMPO BPM="127.530014" BPM_QUALITY="100.000000"></TEMPO>
    </ENTRY>

    <ENTRY MODIFIED_DATE="2024/3/17" TITLE="Gamma Echo" ARTIST="Test Artist Three">
      <LOCATION DIR="/:Music/:Sets/:" FILE="gamma.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" GENRE="Psytech" PLAYTIME="180" PLAYTIME_FLOAT="180.25" RANKING="0" IMPORT_DATE="2023/11/6"></INFO>
      <TEMPO BPM="141.960007" BPM_QUALITY="100.000000"></TEMPO>
    </ENTRY>

    <!--
      B8 probe: same FILE name as the Sets/ entry above, different DIR.
      Drive matching is by bare filename, so this is the collision case.
    -->
    <ENTRY MODIFIED_DATE="2024/3/17" TITLE="Alpha Drift (Archive Cut)" ARTIST="Test Artist One">
      <LOCATION DIR="/:Music/:Archive/:" FILE="alpha.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" GENRE="Psytech" PLAYTIME="250" PLAYTIME_FLOAT="250.0" RANKING="60"></INFO>
    </ENTRY>

    <!--
      A recording, in the folder shape the real collection uses. Its name has a
      trailing date, so SetName must strip that to reach the set id "Z11-3" and
      find the playlist family below.
    -->
    <ENTRY MODIFIED_DATE="2021/9/17" TITLE="Z11-3 2021-09-17" ARTIST="">
      <LOCATION DIR="/:Users/:toni/:Google Drive/:Musiikki/:Traktor/:Setit/:" FILE="Z11-3 2021-09-17.mp3" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="7451" PLAYTIME_FLOAT="7451.0" IMPORT_DATE="2021/9/18"></INFO>
    </ENTRY>

    <!--
      Year-collision probe: the code "C4" is reused across years, so this must
      match the 2026 playlist and not the 2025 one.
    -->
    <ENTRY MODIFIED_DATE="2026/8/16" TITLE="C4 2026-08-16" ARTIST="">
      <LOCATION DIR="/:Users/:toni/:Google Drive/:Musiikki/:Traktor/:Setit/:" FILE="C4 2026-08-16.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" PLAYTIME="5400" PLAYTIME_FLOAT="5400.0" IMPORT_DATE="2026/8/17"></INFO>
    </ENTRY>

    <!--
      In the collection but absent from Drive: exercises the "no matching file"
      path. Its folder is the local-only Recordings directory Traktor writes to,
      which is the real-world reason this happens.
    -->
    <ENTRY MODIFIED_DATE="2022/2/19" TITLE="Epsilon Local Only" ARTIST="Test Artist Five">
      <LOCATION DIR="/:Users/:toni/:Music/:Traktor/:Recordings/:" FILE="epsilon-local.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" PLAYTIME="600" PLAYTIME_FLOAT="600.0" IMPORT_DATE="2022/2/20"></INFO>
    </ENTRY>

    <!-- Present in the collection but NOT referenced by any playlist. -->
    <ENTRY MODIFIED_DATE="2024/3/17" TITLE="Delta Unlisted" ARTIST="Test Artist Four">
      <LOCATION DIR="/:Music/:Archive/:" FILE="delta.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" PLAYTIME="90" PLAYTIME_FLOAT="90.0"></INFO>
    </ENTRY>

    <!--
      Gig preview (ADR 20261018-47). Every cue sits inside the first 2 s, because
      the mock serves the same 2-second WAV for every file, and PLAYTIME matches
      it. CUE_V2 START/LEN are milliseconds; HOTCUE is 0-based, -1 = none.
    -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Gig One" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="gig-one.mp3" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="2" PLAYTIME_FLOAT="2.0" FILESIZE="4000"></INFO>
      <TEMPO BPM="120.000000"></TEMPO>
      <CUE_V2 NAME="AutoGrid" DISPL_ORDER="0" TYPE="4" START="10.0" LEN="0.0" REPEATS="-1" HOTCUE="-1"><GRID BPM="120.0"></GRID></CUE_V2>
      <CUE_V2 NAME="Intro" DISPL_ORDER="0" TYPE="0" START="100.0" LEN="0.0" REPEATS="-1" HOTCUE="0"></CUE_V2>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="3" START="300.0" LEN="0.0" REPEATS="-1" HOTCUE="1"></CUE_V2>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="5" START="500.0" LEN="400.0" REPEATS="-1" HOTCUE="2"></CUE_V2>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="5" START="1000.0" LEN="500.0" REPEATS="-1" HOTCUE="3"></CUE_V2>
    </ENTRY>

    <!-- No load cue: preview starts at 0. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Gig Two" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="gig-two.flac" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="900000" PLAYTIME="2" PLAYTIME_FLOAT="2.0" FILESIZE="200"></INFO>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="5" START="200.0" LEN="400.0" REPEATS="-1" HOTCUE="1"></CUE_V2>
    </ENTRY>

    <!-- Not in Drive: preview must skip it. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Gig Local Only" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="gig-local.mp3" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="2" PLAYTIME_FLOAT="2.0"></INFO>
    </ENTRY>

    <!-- No loop cue: preview plays to the end. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Gig Three" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="gig-three.mp3" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="2" PLAYTIME_FLOAT="2.0" FILESIZE="80"></INFO>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="3" START="400.0" LEN="0.0" REPEATS="-1" HOTCUE="0"></CUE_V2>
    </ENTRY>

    <!-- The only loop ends before the load cue: ignored, so it plays to the end. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Gig Four" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="gig-four.mp3" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="2" PLAYTIME_FLOAT="2.0" FILESIZE="80"></INFO>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="3" START="1500.0" LEN="0.0" REPEATS="-1" HOTCUE="0"></CUE_V2>
      <CUE_V2 NAME="n.n." DISPL_ORDER="0" TYPE="5" START="200.0" LEN="300.0" REPEATS="-1" HOTCUE="1"></CUE_V2>
    </ENTRY>

    <!--
      Unresolved-entry probes, all in the "Gig Night" playlist.

      A separator as Traktor users make one: a few seconds of silence, titled
      and "artisted" with rule characters. Its path contains "silent", so the
      parser drops it. It IS in Drive (see drive-mock.ts) and must still never play.
    -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="==== Part 2" ARTIST="==============">
      <LOCATION DIR="/:Music/:Gig/:" FILE="silent.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411200" LABEL="====" PLAYTIME="4" PLAYTIME_FLOAT="4.0" RANKING="0" COLOR="1"></INFO>
    </ENTRY>

    <!-- A Beatport streaming track: a web address, no file. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Stream Only" ARTIST="Gig Artist">
      <LOCATION WEBADDRESS="beatport://tracks/16477657"></LOCATION>
      <INFO BITRATE="128000" PLAYTIME="189" PLAYTIME_FLOAT="189.0"></INFO>
    </ENTRY>

    <!--
      FILE in NFD ("e" + U+0301 combining acute, as macOS stores it) while the
      playlist key below spells it NFC. Drive has it NFC.
    -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="Cafe Accent" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:Gig/:" FILE="Cafe&#x301; Noir.wav" VOLUME="Macintosh HD"></LOCATION>
      <INFO BITRATE="1411000" PLAYTIME="2" PLAYTIME_FLOAT="2.0"></INFO>
    </ENTRY>

    <!-- On a USB stick: the parser only strips "Macintosh HD", so its key never matched. -->
    <ENTRY MODIFIED_DATE="2026/8/1" TITLE="USB Anthem" ARTIST="Gig Artist">
      <LOCATION DIR="/:Music/:" FILE="usb-anthem.mp3" VOLUME="TONIPIONEER"></LOCATION>
      <INFO BITRATE="320000" PLAYTIME="2" PLAYTIME_FLOAT="2.0"></INFO>
    </ENTRY>

  </COLLECTION>

  <PLAYLISTS>
    <NODE TYPE="FOLDER" NAME="$ROOT">
      <SUBNODES COUNT="4">

        <!-- Playlist directly under $ROOT — renders under the "$ROOT" pseudo-folder (B10). -->
        <NODE TYPE="PLAYLIST" NAME="Root Level Playlist">
          <PLAYLIST ENTRIES="1" TYPE="LIST" UUID="00000000000000000000000000000001">
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:gamma.wav"></PRIMARYKEY></ENTRY>
          </PLAYLIST>
        </NODE>

        <NODE TYPE="FOLDER" NAME="My Sets">
          <SUBNODES COUNT="4">
            <NODE TYPE="PLAYLIST" NAME="Psytech 2024">
              <PLAYLIST ENTRIES="4" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:alpha.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:beta.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:gamma.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Archive/:alpha.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <NODE TYPE="PLAYLIST" NAME="Z11-3">
              <PLAYLIST ENTRIES="3" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f60">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:alpha.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:beta.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:gamma.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <NODE TYPE="PLAYLIST" NAME="Z11-3.rec">
              <PLAYLIST ENTRIES="2" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f61">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:beta.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:gamma.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <NODE TYPE="PLAYLIST" NAME="C4 2025 Dark Tek Chillout">
              <PLAYLIST ENTRIES="1" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f63">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:alpha.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <NODE TYPE="PLAYLIST" NAME="C4 2026 Dark Tek Chillout">
              <PLAYLIST ENTRIES="2" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f64">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:beta.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:gamma.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <NODE TYPE="PLAYLIST" NAME="Empty Set">
              <PLAYLIST ENTRIES="0" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5b">
              </PLAYLIST>
            </NODE>
          </SUBNODES>
        </NODE>

        <NODE TYPE="PLAYLIST" NAME="Gig Prep">
          <PLAYLIST ENTRIES="5" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f66">
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-one.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-two.flac"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-local.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-three.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-four.mp3"></PRIMARYKEY></ENTRY>
          </PLAYLIST>
        </NODE>

        <!--
          Every kind of entry Playlist.Tracks used to drop, between playable
          ones. Traktor numbers all ten. "vanished-dub" is in no collection
          entry at all; Gig One appears twice, both rows kept.
        -->
        <NODE TYPE="PLAYLIST" NAME="Gig Night">
          <PLAYLIST ENTRIES="10" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f67">
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-one.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:silent.wav"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-two.flac"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="STREAM" KEY="beatport://tracks/16477657"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:Caf&#xE9; Noir.wav"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gone/:vanished-dub.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="TONIPIONEER/:Music/:usb-anthem.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-local.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-one.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Gig/:gig-three.mp3"></PRIMARYKEY></ENTRY>
          </PLAYLIST>
        </NODE>

        <NODE TYPE="PLAYLIST" NAME="Recorded sets">
          <PLAYLIST ENTRIES="2" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f62">
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Users/:toni/:Google Drive/:Musiikki/:Traktor/:Setit/:Z11-3 2021-09-17.mp3"></PRIMARYKEY></ENTRY>
            <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Users/:toni/:Google Drive/:Musiikki/:Traktor/:Setit/:C4 2026-08-16.wav"></PRIMARYKEY></ENTRY>
          </PLAYLIST>
        </NODE>

        <NODE TYPE="FOLDER" NAME="Archive">
          <SUBNODES COUNT="1">
            <NODE TYPE="PLAYLIST" NAME="Old Sets">
              <PLAYLIST ENTRIES="1" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5c">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Archive/:delta.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
            <!-- One track in Drive, one only on the local disk. -->
            <NODE TYPE="PLAYLIST" NAME="Partly Missing">
              <PLAYLIST ENTRIES="2" TYPE="LIST" UUID="0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f65">
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Music/:Sets/:beta.wav"></PRIMARYKEY></ENTRY>
                <ENTRY><PRIMARYKEY TYPE="TRACK" KEY="Macintosh HD/:Users/:toni/:Music/:Traktor/:Recordings/:epsilon-local.wav"></PRIMARYKEY></ENTRY>
              </PLAYLIST>
            </NODE>
          </SUBNODES>
        </NODE>

      </SUBNODES>
    </NODE>
  </PLAYLISTS>
</NML>
