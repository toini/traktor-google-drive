<!--
  Track discovery fixture (ADR 20261025-54). A slice of the real collection's
  shape: an H folder with an H16-like playlist, and a Z folder.

    1616 (Original Mix)    Obwigszyh, Carnivor Records, 5 stars, "eti lisaa"  -> owned; seeds Obwigszyh + Carnivor
    Take You Underground   Hefty, Darker Sounds, 5 stars, Bandcamp "Visit" comment -> Darker Sounds' URL is known
    Techno Weapon          Hefty, Gastspiel Records, 4 stars
    Compilation Cut        Various Artists, RAW., 4 stars                     -> the artist is stop-listed
    Low Burn               Noseda, Erebos Records, 3 stars                    -> below the 4-star default
    Tetrakis               Dragon, 2TO6 Records (Z), "lisää luuppi!"          -> not a search marker
-->
<NML VERSION="19">
  <HEAD COMPANY="www.native-instruments.com" PROGRAM="Traktor"></HEAD>
  <MUSICFOLDERS></MUSICFOLDERS>
  <COLLECTION ENTRIES="6">
