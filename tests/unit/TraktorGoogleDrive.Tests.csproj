<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the client's pure rules. The Blazor WASM project itself is not
    referenced (a test host cannot load it); the pure files under test are linked
    in instead, so keep them free of Blazor and JS interop.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Run on whatever newer runtime is installed (a dev machine may only have .NET 10). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\TraktorGoogleDrive\Models\CueMarkers.cs" Link="Linked\CueMarkers.cs" />
    <Compile Include="..\..\TraktorGoogleDrive\Models\TrackTime.cs" Link="Linked\TrackTime.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="TraktorNmlParser" Version="0.0.11" />
  </ItemGroup>

</Project>
