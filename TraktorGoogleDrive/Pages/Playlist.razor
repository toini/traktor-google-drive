@page "/playlist/{Uuid}"
@implements IDisposable
@inject IJSRuntime JS
@inject TraktorGoogleDrive.Services.CollectionService CollectionService
@inject TraktorGoogleDrive.Services.DriveService Drive
@inject TraktorGoogleDrive.Services.AuthService Auth
@inject TraktorGoogleDrive.Services.PlayerService Player
@inject TraktorGoogleDrive.Services.AppErrors Errors
@inject TraktorGoogleDrive.Services.SetMatcher SetMatcher

@using TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Models
@using TraktorGoogleDrive.Services
@using System.Diagnostics

<PageTitle>@(Name ?? "Playlist") · Traktor</PageTitle>

<header class="playlist-header">
    <h1 class="playlist-title">
        <span class="playlist-icon" aria-hidden="true">♫</span>
        @(Name ?? "…")
    </h1>
    @if (files is not null)
    {
        <span class="track-count">@files.Count @(files.Count == 1 ? "track" : "tracks")</span>
    }
</header>

@if (loadError is not null)
{
    <p class="state-message error" role="alert">@loadError</p>
}
else if (files is null)
{
    <p class="state-message">Loading tracks…</p>
}
else if (files.Count == 0)
{
    <p class="state-message">This playlist is empty.</p>
}
else
{
    <div class="table-responsive">
        <table id="playlist-table" class="table table-hover playlist-table">
            <thead>
                <tr>
                    <th scope="col" class="col-expand"><span class="visually-hidden">Set</span></th>
                    <th scope="col" class="col-play"><span class="visually-hidden">Play</span></th>
                    <th scope="col" class="sortable" aria-sort="@AriaSort(SortColumn.Title)" @onclick="() => SortBy(SortColumn.Title)">Title<span class="sort-indicator">@Arrow(SortColumn.Title)</span></th>
                    <th scope="col" class="sortable" aria-sort="@AriaSort(SortColumn.Artist)" @onclick="() => SortBy(SortColumn.Artist)">Artist<span class="sort-indicator">@Arrow(SortColumn.Artist)</span></th>
                    <th scope="col" class="sortable" aria-sort="@AriaSort(SortColumn.Folder)" @onclick="() => SortBy(SortColumn.Folder)">Folder<span class="sort-indicator">@Arrow(SortColumn.Folder)</span></th>
                    <th scope="col" class="sortable" aria-sort="@AriaSort(SortColumn.Label)" @onclick="() => SortBy(SortColumn.Label)">Label<span class="sort-indicator">@Arrow(SortColumn.Label)</span></th>
                    <th scope="col" class="sortable" aria-sort="@AriaSort(SortColumn.Comment)" @onclick="() => SortBy(SortColumn.Comment)">Comment<span class="sort-indicator">@Arrow(SortColumn.Comment)</span></th>
                    <th scope="col" class="col-time sortable" aria-sort="@AriaSort(SortColumn.Length)" @onclick="() => SortBy(SortColumn.Length)">Length<span class="sort-indicator">@Arrow(SortColumn.Length)</span></th>
                    <th scope="col" class="col-added sortable" aria-sort="@AriaSort(SortColumn.Added)" @onclick="() => SortBy(SortColumn.Added)">Added<span class="sort-indicator">@Arrow(SortColumn.Added)</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in SortedFiles())
                {
                    var missing = string.IsNullOrEmpty(file.DriveFileId);
                    var recording = IsRecording(file);
                    var open = expanded.Contains(file.DriveFileId);
                    <tr class="@RowClass(file)" title="@file.Track?.Path">
                        <td class="col-expand">
                            @if (recording)
                            {
                                <button class="expander @(open ? "open" : "")"
                                        title="@(open ? "Hide" : "Show") the playlist for this set"
                                        aria-expanded="@(open ? "true" : "false")"
                                        @onclick="() => ToggleSet(file)">▸</button>
                            }
                        </td>
                        <td class="col-play">
                            @if (missing)
                            {
                                <span class="missing-marker" title="No matching file in Drive">—</span>
                            }
                            else
                            {
                                <AudioTrack File="@file" Token="@token" />
                            }
                        </td>
                        <td class="cell-title">@(file.Track?.Title ?? Path.GetFileName(file.Track?.Path ?? ""))</td>
                        <td class="cell-artist">@(file.Track?.Artist ?? "")</td>
                        <td class="cell-folder">@FolderOf(file.Track?.Path)</td>
                        <td class="cell-label">@(file.Track?.Label ?? "")</td>
                        <td class="cell-comment">@(file.Track?.Comment ?? "")</td>
                        <td class="col-time">@TrackTime.Format(file.Track?.PlaytimeFloat)</td>
                        <td class="col-added">@TrackDate.Format(file.Track?.ImportDate)</td>
                    </tr>

                    @if (recording && open)
                    {
                        <tr class="set-detail-row">
                            <td colspan="9">
                                <SetDetail Recording="@file" Token="@token" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (missingCount > 0)
    {
        <div class="missing-list">
            <button class="link-button small" @onclick="() => showMissing = !showMissing">
                @missingCount of @files.Count tracks @(missingCount == 1 ? "has" : "have")
                no matching file in Drive @(showMissing ? "▾" : "▸")
            </button>

            @if (showMissing)
            {
                <ul>
                    @foreach (var file in files.Where(f => string.IsNullOrEmpty(f.DriveFileId)))
                    {
                        <li>
                            <span class="missing-name">@(file.Track?.Title ?? Path.GetFileName(file.Track?.Path ?? ""))</span>
                            <span class="missing-path">@file.Track?.Path</span>
                        </li>
                    }
                </ul>
                <p class="missing-hint">
                    These are in the Traktor collection but not in Drive under that
                    filename — usually a local-only recording, or a file renamed or
                    moved since Traktor indexed it.
                </p>
            }
        </div>
    }
}

@code {
    [Parameter] public string? Uuid { get; set; }

    string? Name;
    List<FileEntry>? files;
    string? token;
    string? loadError;
    int missingCount;
    bool showMissing;

    enum SortColumn { Title, Artist, Folder, Label, Comment, Length, Added }

    readonly HashSet<string> expanded = [];

    // Only recordings map to a playlist; an ordinary track does not.
    static bool IsRecording(FileEntry file)
    {
        var path = file.Track?.Path ?? "";
        return path.Contains("/Setit/", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/Gig preparation/", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/Recordings/", StringComparison.OrdinalIgnoreCase);
    }

    void ToggleSet(FileEntry file)
    {
        if (!expanded.Remove(file.DriveFileId)) expanded.Add(file.DriveFileId);
    }

    // Default: ascending by Title. Null column means Traktor's own playlist
    // order — the mix order the user built, so it must stay reachable.
    SortColumn? sortColumn = SortColumn.Title;
    bool sortAscending = true;

    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    string RowClass(FileEntry file) =>
        !string.IsNullOrEmpty(file.DriveFileId) && Player.CurrentFileId == file.DriveFileId
            ? "currently-playing"
            : "";

    static string FolderOf(string? path) =>
        string.IsNullOrEmpty(path) ? "" : Path.GetFileName(Path.GetDirectoryName(path) ?? "");

    async Task SortBy(SortColumn column)
    {
        if (sortColumn != column) { sortColumn = column; sortAscending = true; }
        else if (sortAscending) { sortAscending = false; }
        else { sortColumn = null; } // third click: back to Traktor's own order

        await SaveSortStateAsync();
    }

    string Arrow(SortColumn column) =>
        sortColumn != column ? "" : sortAscending ? "▲" : "▼";

    string AriaSort(SortColumn column) =>
        sortColumn != column ? "none" : sortAscending ? "ascending" : "descending";

    IEnumerable<FileEntry> SortedFiles()
    {
        if (files is null) return [];
        if (sortColumn is null) return files;

        if (sortColumn == SortColumn.Length)
        {
            var byHasLength = files.OrderBy(f => f.Track?.PlaytimeFloat is null);
            return sortAscending
                ? byHasLength.ThenBy(f => f.Track?.PlaytimeFloat ?? 0)
                : byHasLength.ThenByDescending(f => f.Track?.PlaytimeFloat ?? 0);
        }

        if (sortColumn == SortColumn.Added)
        {
            // Parsed, never lexical: "2023/10/10" sorts before "2023/3/12" as text.
            var byHasDate = files.OrderBy(f => TrackDate.Parse(f.Track?.ImportDate) is null);
            return sortAscending
                ? byHasDate.ThenBy(f => TrackDate.Parse(f.Track?.ImportDate))
                : byHasDate.ThenByDescending(f => TrackDate.Parse(f.Track?.ImportDate));
        }

        var column = sortColumn.Value;
        var byHasText = files.OrderBy(f => string.IsNullOrEmpty(TextKey(f, column)));
        return sortAscending
            ? byHasText.ThenBy(f => TextKey(f, column), StringComparer.OrdinalIgnoreCase)
            : byHasText.ThenByDescending(f => TextKey(f, column), StringComparer.OrdinalIgnoreCase);
    }

    static string? TextKey(FileEntry file, SortColumn column) => column switch
    {
        SortColumn.Title => file.Track?.Title ?? Path.GetFileName(file.Track?.Path ?? ""),
        SortColumn.Artist => file.Track?.Artist,
        SortColumn.Folder => FolderOf(file.Track?.Path),
        SortColumn.Label => file.Track?.Label,
        SortColumn.Comment => file.Track?.Comment,
        _ => null,
    };

    string SortStorageKey => $"playlist-sort:{Uuid}";

    async Task LoadSortStateAsync()
    {
        sortColumn = SortColumn.Title;
        sortAscending = true;

        string? raw;
        try { raw = await JS.InvokeAsync<string?>("localStorage.getItem", SortStorageKey); }
        catch { return; }

        if (string.IsNullOrEmpty(raw)) return;
        if (raw == "original") { sortColumn = null; return; }

        var parts = raw.Split(':');
        if (parts.Length == 2 && Enum.TryParse<SortColumn>(parts[0], out var column))
        {
            sortColumn = column;
            sortAscending = parts[1] == "asc";
        }
    }

    async Task SaveSortStateAsync()
    {
        var value = sortColumn is null ? "original" : $"{sortColumn}:{(sortAscending ? "asc" : "desc")}";
        try { await JS.InvokeVoidAsync("localStorage.setItem", SortStorageKey, value); }
        catch { /* storage unavailable — not worth failing the sort over */ }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Uuid)) return;

        // Switching playlists should not leave the previous track playing.
        await Player.StopAsync();

        files = null;
        loadError = null;
        missingCount = 0;
        await LoadSortStateAsync();

        var watch = Stopwatch.StartNew();

        try
        {
            var playlist = await CollectionService.GetPlaylistByUuid(Uuid);
            if (playlist is null)
            {
                loadError = "Playlist not found.";
                return;
            }

            Name = playlist.Name;

            token = await Auth.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                await Auth.HandleExpiredAsync($"/playlist/{Uuid}");
                return;
            }

            files = await Drive.ResolveTracksAsync(playlist.Tracks, token);
            missingCount = files.Count(f => string.IsNullOrEmpty(f.DriveFileId));

            Console.WriteLine($"[Playlist] {playlist.Name}: {files.Count} tracks, "
                            + $"{missingCount} unmatched, {watch.Elapsed.TotalSeconds:0.00}s");
        }
        catch (DriveAuthException ex)
        {
            Errors.Report("Google rejected the access token", ex);
            await Auth.HandleExpiredAsync($"/playlist/{Uuid}");
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Errors.Report("Could not load this playlist", ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // NOT gated on firstRender: tracks load asynchronously, so on the first
        // render files is still null and the resizers were never created at all.
        // initResizableTable is idempotent (it marks the table it has wired up).
        if (files?.Count > 0)
        {
            await JS.InvokeVoidAsync("initResizableTable", "playlist-table");
        }
    }

    public void Dispose()
    {
        Player.Changed -= OnPlayerChanged;
        // Fire-and-forget: Dispose cannot await, and the player owns its own
        // teardown if the circuit is already gone.
        _ = Player.StopAsync();
    }
}
