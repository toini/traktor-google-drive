@page "/playlist/{Uuid}"
@implements IDisposable
@inject IJSRuntime JS
@inject TraktorGoogleDrive.Services.CollectionService CollectionService
@inject TraktorGoogleDrive.Services.DriveService Drive
@inject TraktorGoogleDrive.Services.AuthService Auth
@inject TraktorGoogleDrive.Services.PlayerService Player
@inject TraktorGoogleDrive.Services.AppErrors Errors
@inject TraktorGoogleDrive.Services.SetMatcher SetMatcher

@using TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Models
@using TraktorGoogleDrive.Services
@using System.Diagnostics

<PageTitle>@(Name ?? "Playlist") · Traktor</PageTitle>

<header class="playlist-header">
    <h1 class="playlist-title">
        <span class="playlist-icon" aria-hidden="true">♫</span>
        @(Name ?? "…")
    </h1>
    @if (files is not null)
    {
        @* Every ENTRY counts, separators and unplayable ones too, so this is
           the number Traktor shows for the playlist. *@
        <span class="track-count" data-track-count="@files.Count">
            @files.Count @(files.Count == 1 ? "track" : "tracks")@if (separatorCount > 0)
            {
                <span data-separator-count="@separatorCount"> · @separatorCount @(separatorCount == 1 ? "separator" : "separators")</span>
            }@if (NotPlayableCount > 0)
            {
                <span class="not-playable-count" data-not-playable="@NotPlayableCount" title="@NotPlayableBreakdown"> · @NotPlayableCount not playable</span>
            }
        </span>
        @if (files.Any(f => f.IsPlayable))
        {
            @* Gig preview walks the table down in its current sort, each track from
               its load cue to the end of its last loop (ADR 20261018-47). It starts
               at the loaded track when that is one of these rows, else at the top. *@
            var from = Player.PreviewStartEntry;
            <button class="preview-set-button" data-preview-set data-preview-from="@from?.PlaylistIndex"
                    title="@PreviewTitle(from)"
                    @onclick="StartPreview">▶ Preview set</button>
        }
    }
    @if (files is { Count: > 0 })
    {
        <ColumnPicker Columns="@ColumnChoices" OnToggle="ToggleColumnAsync" OnReset="ResetColumnsAsync" />
    }
</header>

@if (loadError is not null)
{
    <p class="state-message error" role="alert">@loadError</p>
}
else if (files is null)
{
    <p class="state-message">Loading tracks…</p>
}
else if (files.Count == 0)
{
    <p class="state-message">This playlist is empty.</p>
}
else
{
    <div class="table-responsive">
        @* data-legacy-cols: the column order of the old position-keyed widths,
           so table-resize.js can carry them over to id keys once. *@
        <table id="playlist-table" class="table table-hover playlist-table"
               data-legacy-cols="expand,play,index,title,artist,folder,label,comment2,comment,length,added">
            <thead>
                <tr>
                    <th scope="col" class="col-expand" data-col="expand"><span class="visually-hidden">Set</span></th>
                    <th scope="col" class="col-play" data-col="play"><span class="visually-hidden">Play</span></th>
                    <th scope="col" class="col-index sortable" data-col="index" aria-sort="@AriaSort(SortColumn.Index)" @onclick="() => SortBy(SortColumn.Index)">#<span class="sort-indicator">@Arrow(SortColumn.Index)</span></th>
                    @* Keyed, so a <th> keeps its identity (and its resized width)
                       when a column before it is hidden. *@
                    @foreach (var column in VisibleColumns)
                    {
                        <th @key="column.Id" scope="col" class="@column.HeaderClass" data-col="@column.Id" aria-sort="@AriaSort(column.Sort)" @onclick="() => SortBy(column.Sort)">@column.Label<span class="sort-indicator">@Arrow(column.Sort)</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var file in SortedFiles())
                {
                    @if (file.Kind == EntryKind.Separator)
                    {
                        @* Keeps its place and its # but is never played: no play
                           button, and PlayerService.SetQueue drops it (no Drive id). *@
                        <tr class="separator-row" data-entry-kind="separator" title="@file.EntryKey">
                            <td class="col-expand"></td>
                            <td class="col-play"></td>
                            <td class="col-index">@file.PlaylistIndex</td>
                            <td colspan="@VisibleColumns.Count" class="separator-cell">
                                <span class="separator-rule" aria-hidden="true"></span>
                                <span class="separator-label">@PlaylistEntries.SeparatorLabel(file.EntryTitle)</span>
                                <span class="separator-rule" aria-hidden="true"></span>
                            </td>
                        </tr>
                        continue;
                    }
                    var missing = !file.IsPlayable;
                    var recording = IsRecording(file);
                    var open = expanded.Contains(file.DriveFileId);
                    var color = CollectionService.ColorOf(file.Track);
                    <tr class="@RowClass(file)" title="@(file.Track?.Path is { Length: > 0 } path ? path : file.EntryKey)"
                        data-entry-kind="@KindAttribute(file)">
                        <td class="col-expand">
                            @if (recording)
                            {
                                <button class="expander @(open ? "open" : "")"
                                        title="@(open ? "Hide" : "Show") the playlist for this set"
                                        aria-expanded="@(open ? "true" : "false")"
                                        @onclick="() => ToggleSet(file)">▸</button>
                            }
                        </td>
                        <td class="col-play">
                            @if (missing)
                            {
                                <span class="missing-marker" title="@NotPlayableReason(file)">—</span>
                            }
                            else
                            {
                                <AudioTrack File="@file" Token="@token" />
                            }
                        </td>
                        @* Traktor shows its track color as a swatch, not a word: here a
                           bar down the left of the index cell. *@
                        <td class="col-index @(color is null ? "" : $"track-color-{color}")"
                            data-track-color="@color"
                            title="@(color is null ? null : $"Color: {ColorNames[color.Value]}")">@file.PlaylistIndex</td>
                        @foreach (var column in VisibleColumns)
                        {
                            @if (column.Render is { } render)
                            {
                                <td @key="column.Id" class="@column.CellClass">@render(file)</td>
                            }
                            else
                            {
                                <td @key="column.Id" class="@column.CellClass">@column.Value(file)</td>
                            }
                        }
                    </tr>

                    @if (recording && open)
                    {
                        <tr class="set-detail-row">
                            <td colspan="@(FixedColumnCount + VisibleColumns.Count)">
                                <SetDetail Recording="@file" Token="@token" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (missingCount > 0)
    {
        <div class="missing-list">
            <button class="link-button small" @onclick="() => showMissing = !showMissing">
                @missingCount of @files.Count tracks @(missingCount == 1 ? "has" : "have")
                no matching file in Drive @(showMissing ? "▾" : "▸")
            </button>

            @if (showMissing)
            {
                <ul>
                    @foreach (var file in files.Where(f => f.Kind == EntryKind.Track && !f.IsPlayable))
                    {
                        <li>
                            <span class="missing-name">@(file.Track?.Title ?? Path.GetFileName(file.Track?.Path ?? ""))</span>
                            <span class="missing-path">@file.Track?.Path</span>
                        </li>
                    }
                </ul>
                <p class="missing-hint">
                    These are in the Traktor collection but not in Drive under that
                    filename — usually a local-only recording, or a file renamed or
                    moved since Traktor indexed it.
                </p>
            }
        </div>
    }
}

@code {
    [Parameter] public string? Uuid { get; set; }

    string? Name;
    string? shownUuid;
    List<FileEntry>? files;
    string? token;
    string? loadError;
    // Collection tracks with no Drive file; the existing "missing" list.
    int missingCount;
    int separatorCount;
    int streamingCount;
    int notInCollectionCount;
    bool showMissing;

    int NotPlayableCount => missingCount + streamingCount + notInCollectionCount;

    string NotPlayableBreakdown => string.Join("\n", new[]
    {
        (missingCount, "no matching file in Drive"),
        (streamingCount, "streaming (Beatport/Beatsource), no file to play"),
        (notInCollectionCount, "not in the collection.nml in Drive"),
    }.Where(r => r.Item1 > 0).Select(r => $"{r.Item1} {r.Item2}"));

    static string KindAttribute(FileEntry file) => file.Kind switch
    {
        EntryKind.Streaming => "streaming",
        EntryKind.NotInCollection => "not-in-collection",
        EntryKind.Separator => "separator",
        _ => file.IsPlayable ? "track" : "no-drive-file",
    };

    static string NotPlayableReason(FileEntry file) => file.Kind switch
    {
        EntryKind.Streaming => "Streaming track: there is no file to play",
        EntryKind.NotInCollection => "Not in the collection.nml in Drive",
        _ => "No matching file in Drive",
    };

    // The words on the row's marker; null for an ordinary track.
    static string? MarkerText(FileEntry file) => file.Kind switch
    {
        EntryKind.Streaming => "streaming",
        EntryKind.NotInCollection => "not in collection",
        _ => null,
    };

    static string TitleOf(FileEntry f) =>
        f.Track?.Title is { Length: > 0 } title ? title
        : f.EntryTitle is { Length: > 0 } entry ? entry
        : Path.GetFileName(f.Track?.Path ?? "");

    static RenderFragment TitleCell(FileEntry f)
    {
        var marker = MarkerText(f);
        var kind = KindAttribute(f);
        var reason = NotPlayableReason(f);
        // Marker first: the title cell truncates with an ellipsis, and the
        // marker is the part that must stay visible.
        return @<span>@if (marker is not null)
        {
            <span class="entry-marker" data-entry-marker="@kind" title="@reason">@marker</span>
        }@TitleOf(f)</span>;
    }

    // Comment2 is Traktor's "Comment 2", which the NML stores as INFO RATING
    // (the star rating is RANKING), hence Track.Rating below.
    enum SortColumn { Index, Title, Artist, Release, Folder, Label, Comment2, Comment, Rating, Bpm, Length, Added }

    static readonly Dictionary<int, string> ColorNames = new()
    {
        [1] = "Red", [2] = "Orange", [3] = "Yellow", [4] = "Green",
        [5] = "Blue", [6] = "Violet", [7] = "Magenta",
    };

    readonly HashSet<string> expanded = [];

    // Only recordings map to a playlist; an ordinary track does not.
    static bool IsRecording(FileEntry file)
    {
        var path = file.Track?.Path ?? "";
        return path.Contains("/Setit/", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/Gig preparation/", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/Recordings/", StringComparison.OrdinalIgnoreCase);
    }

    void ToggleSet(FileEntry file)
    {
        if (!expanded.Remove(file.DriveFileId)) expanded.Add(file.DriveFileId);
    }

    // Default: ascending by Index, i.e. Traktor's playlist order, so a playlist
    // reads (and is listened through) the way it was built. Null column is the
    // same order reached by the third click on any other header.
    SortColumn? sortColumn = SortColumn.Index;
    bool sortAscending = true;

    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    string RowClass(FileEntry file) =>
        !string.IsNullOrEmpty(file.DriveFileId) && Player.CurrentFileId == file.DriveFileId
            ? "currently-playing"
            : "";

    static string FolderOf(string? path) =>
        string.IsNullOrEmpty(path) ? "" : Path.GetFileName(Path.GetDirectoryName(path) ?? "");

    async Task SortBy(SortColumn column)
    {
        if (sortColumn != column) { sortColumn = column; sortAscending = true; }
        else if (sortAscending) { sortAscending = false; }
        else { sortColumn = null; } // third click: back to Traktor's own order

        PushQueue();
        await SaveSortStateAsync();
    }

    /// <summary>"Next track" is the next row on screen, so the player gets every re-sort.</summary>
    void PushQueue() => Player.SetQueue(SortedFiles());

    async Task StartPreview()
    {
        PushQueue();
        await Player.StartPreviewAsync();
    }

    string PreviewTitle(FileEntry? from)
    {
        const string what = "each track from its load cue to the end of its last loop, then the next";
        if (from is null) return $"Play {what}";
        var where = from.DriveFileId == Player.CurrentFileId ? " (the current track)" : "";
        return $"Preview from #{from.PlaylistIndex}{where}: {what}";
    }

    string Arrow(SortColumn column) =>
        sortColumn != column ? "" : sortAscending ? "▲" : "▼";

    string AriaSort(SortColumn column) =>
        sortColumn != column ? "none" : sortAscending ? "ascending" : "descending";

    IEnumerable<FileEntry> SortedFiles()
    {
        if (files is null) return [];
        if (sortColumn is null) return files;

        if (sortColumn == SortColumn.Index)
        {
            return sortAscending
                ? files.OrderBy(f => f.PlaylistIndex)
                : files.OrderByDescending(f => f.PlaylistIndex);
        }

        if (sortColumn == SortColumn.Length)
        {
            var byHasLength = files.OrderBy(f => f.Track?.PlaytimeFloat is null);
            return sortAscending
                ? byHasLength.ThenBy(f => f.Track?.PlaytimeFloat ?? 0)
                : byHasLength.ThenByDescending(f => f.Track?.PlaytimeFloat ?? 0);
        }

        if (sortColumn == SortColumn.Rating)
        {
            // By stars, not the raw 0-255 value: 60 and 51 are both one star.
            var byRated = files.OrderBy(f => StarsOf(f.Ranking) == 0);
            return sortAscending
                ? byRated.ThenBy(f => StarsOf(f.Ranking))
                : byRated.ThenByDescending(f => StarsOf(f.Ranking));
        }

        if (sortColumn == SortColumn.Bpm)
        {
            var byHasBpm = files.OrderBy(f => BpmOf(f) is null);
            return sortAscending
                ? byHasBpm.ThenBy(f => BpmOf(f) ?? 0)
                : byHasBpm.ThenByDescending(f => BpmOf(f) ?? 0);
        }

        if (sortColumn == SortColumn.Added)
        {
            // Parsed, never lexical: "2023/10/10" sorts before "2023/3/12" as text.
            var byHasDate = files.OrderBy(f => TrackDate.Parse(f.Track?.ImportDate) is null);
            return sortAscending
                ? byHasDate.ThenBy(f => TrackDate.Parse(f.Track?.ImportDate))
                : byHasDate.ThenByDescending(f => TrackDate.Parse(f.Track?.ImportDate));
        }

        var column = sortColumn.Value;
        var byHasText = files.OrderBy(f => string.IsNullOrEmpty(TextKey(f, column)));
        return sortAscending
            ? byHasText.ThenBy(f => TextKey(f, column), StringComparer.OrdinalIgnoreCase)
            : byHasText.ThenByDescending(f => TextKey(f, column), StringComparer.OrdinalIgnoreCase);
    }

    static string? TextKey(FileEntry file, SortColumn column) => column switch
    {
        SortColumn.Title => TitleOf(file),
        SortColumn.Artist => file.Track?.Artist,
        SortColumn.Release => file.Release,
        SortColumn.Folder => FolderOf(file.Track?.Path),
        SortColumn.Label => file.Track?.Label,
        SortColumn.Comment2 => file.Track?.Rating,
        SortColumn.Comment => file.Track?.Comment,
        _ => null,
    };

    string SortStorageKey => $"playlist-sort:{Uuid}";

    async Task LoadSortStateAsync()
    {
        sortColumn = SortColumn.Index;
        sortAscending = true;

        string? raw;
        try { raw = await JS.InvokeAsync<string?>("localStorage.getItem", SortStorageKey); }
        catch { return; }

        if (string.IsNullOrEmpty(raw)) return;
        if (raw == "original") { sortColumn = null; return; }

        var parts = raw.Split(':');
        if (parts.Length == 2 && Enum.TryParse<SortColumn>(parts[0], out var column))
        {
            sortColumn = column;
            sortAscending = parts[1] == "asc";
        }
    }

    async Task SaveSortStateAsync()
    {
        var value = sortColumn is null ? "original" : $"{sortColumn}:{(sortAscending ? "asc" : "desc")}";
        try { await JS.InvokeVoidAsync("localStorage.setItem", SortStorageKey, value); }
        catch { /* storage unavailable — not worth failing the sort over */ }
    }

    // Columns ---------------------------------------------------------------
    // Expand, play and # are always shown and are not in this list. Title is
    // Locked: a table of tracks with no names is not worth offering.

    sealed record DataColumn(
        string Id, string Label, SortColumn Sort, string HeaderClass, string CellClass,
        bool Locked, bool DefaultVisible, Func<FileEntry, string> Value)
    {
        /// <summary>Markup for the cell, when plain text (Value) is not enough.</summary>
        public Func<FileEntry, RenderFragment>? Render { get; init; }
    }

    const int FixedColumnCount = 3; // expand, play, #

    static readonly DataColumn[] DataColumns =
    [
        new("title", "Title", SortColumn.Title, "sortable", "cell-title", Locked: true, DefaultVisible: true,
            TitleOf) { Render = TitleCell },
        new("artist", "Artist", SortColumn.Artist, "sortable", "cell-artist", false, true, f => f.Track?.Artist ?? ""),
        // Off by default: the release (ALBUM TITLE) is something to look up,
        // not something to read down a playlist.
        new("release", "Release", SortColumn.Release, "sortable", "cell-release", false, false, f => f.Release ?? ""),
        // Off by default: the playlist already says where its tracks belong,
        // and the Drive folder name rarely adds anything to that.
        new("folder", "Folder", SortColumn.Folder, "sortable", "cell-folder", false, false, f => FolderOf(f.Track?.Path)),
        new("label", "Label", SortColumn.Label, "sortable", "cell-label", false, true, f => f.Track?.Label ?? ""),
        new("comment2", "Comment 2", SortColumn.Comment2, "sortable", "cell-comment2", false, true, f => f.Track?.Rating ?? ""),
        new("comment", "Comment", SortColumn.Comment, "sortable", "cell-comment", false, true, f => f.Track?.Comment ?? ""),
        new("rating", "Rating", SortColumn.Rating, "col-rating sortable", "col-rating", false, true,
            f => StarsOf(f.Ranking) is var n and > 0 ? $"{n} of 5" : "") { Render = f => RatingStars(f.Ranking) },
        // TEMPO BPM, which TraktorNmlParser reads as Track.Bpm.
        new("bpm", "BPM", SortColumn.Bpm, "col-bpm sortable", "col-bpm", false, true, f => FormatBpm(BpmOf(f))),
        new("length", "Length", SortColumn.Length, "col-time sortable", "col-time", false, true,
            f => TrackTime.Format(f.Track?.PlaytimeFloat)),
        new("added", "Added", SortColumn.Added, "col-added sortable", "col-added", false, true,
            f => TrackDate.Format(f.Track?.ImportDate)),
    ];

    /// <summary>The track's BPM; null when Traktor has none (no TEMPO, or 0).</summary>
    static float? BpmOf(FileEntry file) => file.Track?.Bpm is float bpm && bpm > 0 ? bpm : null;

    /// <summary>
    /// One decimal place, without a trailing ".0": 128.000061 is "128" and
    /// 127.53 is "127.5". Blank when there is no BPM.
    /// </summary>
    static string FormatBpm(float? bpm) =>
        bpm is null ? "" : Math.Round((double)bpm.Value, 1, MidpointRounding.AwayFromZero)
            .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// RANKING to whole stars. Traktor writes multiples of 51; anything else
    /// rounds to the nearest star. 0 (or under half a star) is unrated.
    /// </summary>
    static int StarsOf(int? ranking) =>
        ranking is null ? 0 : Math.Clamp((int)Math.Round(ranking.Value / 51.0, MidpointRounding.AwayFromZero), 0, 5);

    // Filled stars in Traktor orange, the rest dim; nothing at all when unrated,
    // so an unrated track reads as blank rather than as "zero stars".
    static RenderFragment RatingStars(int? ranking)
    {
        var stars = StarsOf(ranking);
        if (stars == 0) return _ => { };
        var label = $"{stars} of 5 stars";
        return @<span class="rating-stars" role="img" aria-label="@label" title="@label" data-stars="@stars"><span class="rating-filled">@(new string('★', stars))</span><span class="rating-empty">@(new string('★', 5 - stars))</span></span>;
    }

    HashSet<string> visibleColumnIds = DefaultVisibleColumnIds();

    static HashSet<string> DefaultVisibleColumnIds() =>
        DataColumns.Where(c => c.Locked || c.DefaultVisible).Select(c => c.Id).ToHashSet();

    bool IsVisible(DataColumn column) => column.Locked || visibleColumnIds.Contains(column.Id);

    List<DataColumn> VisibleColumns => DataColumns.Where(IsVisible).ToList();

    IReadOnlyList<ColumnPicker.Choice> ColumnChoices =>
        DataColumns.Select(c => new ColumnPicker.Choice(c.Id, c.Label, IsVisible(c), c.Locked)).ToList();

    // { "folder": false, "label": true, ... } for every toggleable column.
    // An explicit map rather than a list of visible ids, so a column added
    // later is simply absent and gets its own default.
    string ColumnsStorageKey => $"playlist-columns:v1:{Uuid}";

    async Task LoadColumnStateAsync()
    {
        visibleColumnIds = DefaultVisibleColumnIds();

        string? raw;
        try { raw = await JS.InvokeAsync<string?>("localStorage.getItem", ColumnsStorageKey); }
        catch { return; }
        if (string.IsNullOrEmpty(raw)) return;

        Dictionary<string, bool>? stored;
        try { stored = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, bool>>(raw); }
        catch (System.Text.Json.JsonException) { return; } // corrupt: defaults
        if (stored is null) return;

        // Unknown ids (a column since removed) are ignored by construction.
        foreach (var column in DataColumns.Where(c => !c.Locked))
        {
            if (!stored.TryGetValue(column.Id, out var visible)) continue;
            if (visible) visibleColumnIds.Add(column.Id);
            else visibleColumnIds.Remove(column.Id);
        }
    }

    async Task SaveColumnStateAsync()
    {
        var map = DataColumns.Where(c => !c.Locked).ToDictionary(c => c.Id, c => visibleColumnIds.Contains(c.Id));
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ColumnsStorageKey,
                System.Text.Json.JsonSerializer.Serialize(map));
        }
        catch { /* storage unavailable — the choice still applies for this visit */ }
    }

    async Task ToggleColumnAsync(string id)
    {
        var column = DataColumns.FirstOrDefault(c => c.Id == id);
        if (column is null || column.Locked) return;

        if (!visibleColumnIds.Remove(id)) visibleColumnIds.Add(id);
        await SaveColumnStateAsync();
        await FallBackFromHiddenSortAsync();
    }

    async Task ResetColumnsAsync()
    {
        visibleColumnIds = DefaultVisibleColumnIds();
        try { await JS.InvokeVoidAsync("localStorage.removeItem", ColumnsStorageKey); }
        catch { /* storage unavailable */ }
        await FallBackFromHiddenSortAsync();
    }

    // Sorting by a column you cannot see gives an order with no visible
    // reason, so hiding the sorted column falls back to # (Traktor's order),
    // and that is saved as the sort. A stored sort on a column that is hidden
    // when the page loads is treated the same way.
    async Task FallBackFromHiddenSortAsync()
    {
        var sorted = DataColumns.FirstOrDefault(c => c.Sort == sortColumn);
        if (sorted is null || IsVisible(sorted)) return;

        sortColumn = SortColumn.Index;
        sortAscending = true;
        // Playback follows the table order, so it follows this change too.
        // (On load files is still null; the load pushes the queue itself.)
        if (files is not null) PushQueue();
        await SaveSortStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Uuid)) return;

        // Switching playlists should not leave the previous track playing. Only
        // a real switch: on a fresh page the only thing loaded is the track
        // PlaybackMemory restored after a reload, and that must survive.
        if (shownUuid is not null && shownUuid != Uuid) await Player.StopAsync();
        // Only a different playlist clears the queue (and so ends a gig preview). A
        // parameter pass for the playlist already shown reloads its rows and pushes
        // them again, and must not end a preview that is running over them.
        if (shownUuid != Uuid) Player.ClearQueue();
        shownUuid = Uuid;

        files = null;
        loadError = null;
        missingCount = separatorCount = streamingCount = notInCollectionCount = 0;
        await LoadSortStateAsync();
        await LoadColumnStateAsync();
        await FallBackFromHiddenSortAsync();

        var watch = Stopwatch.StartNew();

        try
        {
            var playlist = await CollectionService.GetPlaylistByUuid(Uuid);
            if (playlist is null)
            {
                loadError = "Playlist not found.";
                return;
            }

            Name = playlist.Name;

            token = await Auth.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                await Auth.HandleExpiredAsync($"/playlist/{Uuid}");
                return;
            }

            files = await BuildRowsAsync(playlist, token);
            missingCount = files.Count(f => f.Kind == EntryKind.Track && !f.IsPlayable);
            separatorCount = files.Count(f => f.Kind == EntryKind.Separator);
            streamingCount = files.Count(f => f.Kind == EntryKind.Streaming);
            notInCollectionCount = files.Count(f => f.Kind == EntryKind.NotInCollection);
            PushQueue();

            Console.WriteLine($"[Playlist] {playlist.Name}: {files.Count} entries, "
                            + $"{separatorCount} separators, {missingCount} not in Drive, "
                            + $"{streamingCount} streaming, {notInCollectionCount} not in collection, "
                            + $"{watch.Elapsed.TotalSeconds:0.00}s");
        }
        catch (DriveAuthException ex)
        {
            Errors.Report("Google rejected the access token", ex);
            await Auth.HandleExpiredAsync($"/playlist/{Uuid}");
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Errors.Report("Could not load this playlist", ex);
        }
    }

    /// <summary>
    /// One row per playlist ENTRY, numbered as Traktor numbers them. Only
    /// collection tracks are looked up in Drive: a separator is never played
    /// even if its silent file is there, and the rest have no file to find.
    /// </summary>
    async Task<List<FileEntry>> BuildRowsAsync(TraktorNmlParser.Models.Playlist playlist, string token)
    {
        var entries = await CollectionService.GetPlaylistEntriesAsync(playlist.Uuid)
            ?? playlist.Tracks.Select((t, i) => new PlaylistEntry(i + 1, "", EntryKind.Track, t, t.Title ?? "")).ToList();

        var toResolve = entries.Where(e => e.Kind == EntryKind.Track).Select(e => e.Track!).ToList();
        // ResolveTracksAsync returns one FileEntry per track, in the order given.
        var resolved = new Queue<FileEntry>(await Drive.ResolveTracksAsync(toResolve, token));

        var rows = new List<FileEntry>(entries.Count);
        foreach (var entry in entries)
        {
            var row = entry.Kind == EntryKind.Track ? resolved.Dequeue() : new FileEntry { Track = entry.Track };
            row.Kind = entry.Kind;
            row.EntryKey = entry.Key;
            row.EntryTitle = entry.Title;
            row.PlaylistIndex = entry.Position;
            // What the parser package does not read, from the same NML.
            row.Ranking = CollectionService.RankingOf(row.Track);
            row.Release = CollectionService.AlbumOf(row.Track);
            rows.Add(row);
        }
        return rows;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // NOT gated on firstRender: tracks load asynchronously, so on the first
        // render files is still null and the resizers were never created at all.
        // initResizableTable is idempotent (it marks the table it has wired up).
        if (files?.Count > 0)
        {
            await JS.InvokeVoidAsync("initResizableTable", "playlist-table");
        }
    }

    public void Dispose()
    {
        Player.Changed -= OnPlayerChanged;
        Player.ClearQueue();
        // Fire-and-forget: Dispose cannot await, and the player owns its own
        // teardown if the circuit is already gone.
        _ = Player.StopAsync();
    }
}
