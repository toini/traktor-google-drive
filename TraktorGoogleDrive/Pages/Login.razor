@page "/login"
@layout MinimalLayout
@inject TraktorGoogleDrive.Services.AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign in · Traktor</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <span class="login-logo">TRAKTOR</span>
            <span class="login-sub">Google Drive</span>
        </div>

        <p class="login-lead">Stream your Traktor collection straight from Drive.</p>

        @if (expired)
        {
            <p class="login-notice" role="status">Your session expired. Please sign in again.</p>
        }
        @if (failed)
        {
            <p class="login-notice error" role="alert">Sign-in was cancelled or failed. Try again.</p>
        }

        <button class="btn-google" @onclick="SignIn" disabled="@busy">
            @(busy ? "Signing in…" : "Sign in with Google")
        </button>

        <p class="login-scope">Read-only access to your Drive files.</p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "expired")] public string? ExpiredFlag { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }

    bool busy;
    bool failed;

    bool expired => !string.IsNullOrEmpty(ExpiredFlag);
    string? returnTo => ReturnTo;

    async Task SignIn()
    {
        busy = true;
        failed = false;

        // Resolves when Google's callback fires, so no polling loop.
        var token = await Auth.SignInAsync();

        busy = false;

        if (string.IsNullOrWhiteSpace(token))
        {
            failed = true;
            return;
        }

        Navigation.NavigateTo(string.IsNullOrEmpty(returnTo) ? "/music" : returnTo, forceLoad: true);
    }
}
