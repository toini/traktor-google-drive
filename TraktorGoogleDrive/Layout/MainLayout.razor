@namespace TraktorGoogleDrive.Layout
@using TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Services
@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="page">
    <aside class="sidebar">
        <a class="traktor-logo" href="/music">
            <h4>TRAKTOR</h4>
            <small>Google Drive</small>
        </a>
        <FolderTree />
    </aside>

    <main>
        <div class="top-row px-4">
            <div class="top-row-brand">
                <span class="brand-text">Music Collection</span>
            </div>
            <button class="link-button" @onclick="SignOut">Sign out</button>
        </div>

        <ErrorBanner />

        <article class="content px-4">
            @Body
        </article>

        <PlayerBar />
    </main>
</div>

@code {
    async Task SignOut()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
