@namespace TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Services
@implements IDisposable
@inject AppErrors Errors

@if (Errors.Any)
{
    <div class="error-banner @(Errors.AnyError ? "level-error" : "level-info")"
         role="@(Errors.AnyError ? "alert" : "status")">
        @* Collapsed, the banner is a single line: the newest entry, cut to fit,
           with the full text in its tooltip and behind "Show details". *@
        <div class="error-banner-head">
            <span class="error-banner-title">@Title</span>
            @if (!expanded && Errors.Errors.Count > 0)
            {
                var latest = Errors.Errors[0];
                <span class="error-banner-peek" title="@latest.Summary">
                    <span class="error-time">@latest.Time</span>
                    <span class="error-summary">@latest.Summary</span>
                </span>
            }
            <button class="error-banner-toggle" aria-expanded="@(expanded ? "true" : "false")"
                    @onclick="() => expanded = !expanded">
                @(expanded ? "Hide" : "Show details")
            </button>
            <button class="error-banner-close" @onclick="Errors.Clear" aria-label="Dismiss">✕</button>
        </div>

        @if (expanded)
        {
            <ul class="error-list">
                @foreach (var entry in Errors.Errors)
                {
                    <li class="@(entry.Severity == Severity.Error ? "is-error" : "is-info")">
                        <span class="error-time">@entry.Time</span>
                        <span class="error-summary">@entry.Summary</span>
                        @if (!string.IsNullOrEmpty(entry.Detail))
                        {
                            <pre class="error-detail">@entry.Detail</pre>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    bool expanded;

    string Title
    {
        get
        {
            var n = Errors.Errors.Count;
            if (!Errors.AnyError) return n == 1 ? "Notice" : $"{n} notices";
            var errors = Errors.Errors.Count(e => e.Severity == Severity.Error);
            return errors == 1 ? "1 error" : $"{errors} errors";
        }
    }

    protected override void OnInitialized() => Errors.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Errors.Changed -= OnChanged;
}
