@namespace TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Models
@using TraktorGoogleDrive.Services
@using TraktorNmlParser.Models
@inject SetMatcher SetMatcher
@inject CollectionService CollectionService

<div class="set-detail">
    @if (loading)
    {
        <p class="state-message">Matching this recording to a playlist…</p>
    }
    else
    {
        <div class="set-detail-head">
            <label for="@SelectId">Playlist for this set</label>
            <select id="@SelectId" value="@(selected?.Uuid ?? "")" @onchange="OnPick">
                <option value="">— none —</option>
                @if (candidates.Count > 0)
                {
                    <optgroup label="Suggested">
                        @foreach (var p in candidates)
                        {
                            <option value="@p.Uuid">@p.Name (@CountOf(p))</option>
                        }
                    </optgroup>
                }
                <optgroup label="All playlists">
                    @foreach (var p in all.Where(p => candidates.All(c => c.Uuid != p.Uuid)))
                    {
                        <option value="@p.Uuid">@p.Name (@CountOf(p))</option>
                    }
                </optgroup>
            </select>

            @if (selected is not null)
            {
                <span class="set-detail-count">@entries.Count @(entries.Count == 1 ? "track" : "tracks")@if (SeparatorCount > 0)
                    {
                        <span> · @SeparatorCount @(SeparatorCount == 1 ? "separator" : "separators")</span>
                    }</span>
            }
            @if (isOverride)
            {
                <button class="link-button small" @onclick="ClearPick" title="Go back to the automatic match">reset</button>
            }
        </div>

        @if (selected is null)
        {
            <p class="state-message subtle">
                No playlist matched this recording. Pick one above — the choice is remembered.
            </p>
        }
        else if (entries.Count == 0)
        {
            <p class="state-message subtle">That playlist is empty.</p>
        }
        else
        {
            @* The same entries as the playlist table (PlaylistEntries), so the
               numbers and the separators match it row for row. Nothing here
               plays; a separator is only a dim rule with its words. *@
            <ol class="set-tracklist">
                @foreach (var e in entries)
                {
                    @if (e.Kind == EntryKind.Separator)
                    {
                        <li value="@e.Position" class="set-separator" data-entry-kind="separator" data-position="@e.Position">
                            <span class="separator-label">@PlaylistEntries.SeparatorLabel(e.Title)</span>
                        </li>
                        continue;
                    }
                    <li value="@e.Position" class="@(e.Kind == EntryKind.Track ? "" : "set-unresolved")"
                        data-entry-kind="@KindAttribute(e.Kind)" data-position="@e.Position">
                        @if (MarkerText(e.Kind) is { } marker)
                        {
                            <span class="entry-marker">@marker</span>
                        }
                        <span class="set-track-title">@TitleOf(e)</span>
                        @if (!string.IsNullOrEmpty(e.Track?.Artist))
                        {
                            <span class="set-track-artist">@e.Track.Artist</span>
                        }
                        <span class="set-track-time">@TrackTime.Format(e.Track?.PlaytimeFloat)</span>
                    </li>
                }
            </ol>
        }
    }
</div>

@code {
    [Parameter] public FileEntry? Recording { get; set; }
    [Parameter] public string? Token { get; set; }

    IReadOnlyList<Playlist> candidates = [];
    IReadOnlyList<Playlist> all = [];
    Playlist? selected;
    bool loading = true;
    bool isOverride;
    // The selected playlist's ENTRY list, every kind, in Traktor's order.
    IReadOnlyList<PlaylistEntry> entries = [];
    readonly Dictionary<string, int> counts = [];

    int SeparatorCount => entries.Count(e => e.Kind == EntryKind.Separator);

    // Traktor's entry count, as the table header shows it, not the parser's
    // Tracks (which drops separators and unresolved entries).
    int CountOf(Playlist p) => counts.TryGetValue(p.Uuid, out var n) ? n : p.Tracks.Count;

    static string KindAttribute(EntryKind kind) => kind switch
    {
        EntryKind.Streaming => "streaming",
        EntryKind.NotInCollection => "not-in-collection",
        EntryKind.Separator => "separator",
        _ => "track",
    };

    static string? MarkerText(EntryKind kind) => kind switch
    {
        EntryKind.Streaming => "streaming",
        EntryKind.NotInCollection => "not in collection",
        _ => null,
    };

    static string TitleOf(PlaylistEntry e) =>
        e.Track?.Title is { Length: > 0 } title ? title
        : e.Title is { Length: > 0 } entry ? entry
        : Path.GetFileName(e.Track?.Path ?? "");

    async Task SelectAsync(Playlist? playlist)
    {
        selected = playlist;
        entries = playlist is null ? []
            : await CollectionService.GetPlaylistEntriesAsync(playlist.Uuid)
              ?? playlist.Tracks.Select((t, i) => new PlaylistEntry(i + 1, "", EntryKind.Track, t, t.Title ?? "")).ToList();
    }

    string SelectId => $"set-pick-{Recording?.DriveFileId}";

    /// Prefer the date in the filename ("C4 2026-08-16") over the import date,
    /// which is when Traktor indexed it rather than when it was played.
    int? RecordingYear()
    {
        var m = System.Text.RegularExpressions.Regex.Match(FileName, @"(20\d{2})-\d{1,2}-\d{1,2}");
        if (m.Success) return int.Parse(m.Groups[1].Value);
        return TrackDate.Parse(Recording?.Track?.ImportDate)?.Year;
    }
    string FileName => Path.GetFileName(Recording?.Track?.Path ?? "");

    protected override async Task OnInitializedAsync()
    {
        if (Recording is null) { loading = false; return; }

        var year = RecordingYear();
        candidates = await SetMatcher.CandidatesAsync(FileName, year);
        all = await SetMatcher.AllPlaylistsAsync();
        foreach (var p in all)
        {
            if (await CollectionService.GetPlaylistEntriesAsync(p.Uuid) is { } list) counts[p.Uuid] = list.Count;
        }
        isOverride = await SetMatcher.GetOverrideAsync(Recording.DriveFileId) is not null;
        await SelectAsync(await SetMatcher.ResolveAsync(FileName, Recording.DriveFileId, year));
        loading = false;
    }

    async Task OnPick(ChangeEventArgs e)
    {
        if (Recording is null) return;
        var uuid = e.Value?.ToString();

        await SetMatcher.SetOverrideAsync(Recording.DriveFileId, uuid);
        isOverride = !string.IsNullOrEmpty(uuid);
        await SelectAsync(string.IsNullOrEmpty(uuid) ? null : all.FirstOrDefault(p => p.Uuid == uuid));
    }

    async Task ClearPick()
    {
        if (Recording is null) return;
        await SetMatcher.SetOverrideAsync(Recording.DriveFileId, null);
        isOverride = false;
        await SelectAsync(await SetMatcher.ResolveAsync(FileName, Recording.DriveFileId, RecordingYear()));
    }
}
