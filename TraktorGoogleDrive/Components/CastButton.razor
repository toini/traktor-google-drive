@namespace TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Services
@implements IDisposable
@inject CastService Cast

<button class="cast-button @StateClass"
        data-cast-state="@StateClass"
        title="@Label"
        aria-label="@Label"
        @onclick="Click">
    <svg viewBox="0 0 24 24" aria-hidden="true">
        @if (Cast.IsConnected)
        {
            <path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm18-7H5v1.63c3.96 1.28 7.09 4.41 8.37 8.37H19V7zm-18 3v2c4.42 0 8 3.58 8 8h2c0-5.52-4.48-10-10-10zM21 3H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
        }
        else
        {
            <path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm0-4v2c4.42 0 8 3.58 8 8h2c0-5.52-4.48-10-10-10zm20-7H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
        }
    </svg>
</button>

@code {
    string StateClass => Cast.IsConnected ? "connected" : Cast.IsAvailable ? "ready" : "unavailable";

    string Label => Cast.IsConnected
        ? $"Casting to {Cast.DeviceName ?? "TV"} — stop casting"
        : Cast.IsAvailable
            ? "Play on a Cast device"
            : "Casting needs Chrome or Edge on this device";

    protected override void OnInitialized() => Cast.Changed += OnCastChanged;

    // Loaded without waiting for a click so an already-running session is rejoined
    // on a reload — autoJoinPolicy only applies once setOptions has run.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cast.EnsureInitializedAsync();
    }

    void OnCastChanged() => InvokeAsync(StateHasChanged);

    async Task Click()
    {
        if (Cast.IsConnected) await Cast.DisconnectAsync();
        else await Cast.ConnectAsync();
    }

    public void Dispose() => Cast.Changed -= OnCastChanged;
}
