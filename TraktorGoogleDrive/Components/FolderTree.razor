@* Namespace: TraktorGoogleDrive.Components *@
@using Microsoft.AspNetCore.Components.Routing
@using TraktorGoogleDrive.Services
@using TraktorNmlParser.Models
@using TraktorGoogleDrive.Models
@inject CollectionService CollectionService
@inject AuthService Auth
@inject AppErrors Errors
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<nav class="folder-tree">
    @if (loadError is not null)
    {
        <p class="folder-tree-message error">@loadError</p>
    }
    else if (!loaded)
    {
        <p class="folder-tree-message">Loading collection…</p>
    }
    else
    {
        @* One list: folders first, loose playlists after, no divider. Interleaved,
           a folder's children read as if they belonged to the playlist above it.
           Rows deliberately avoid Bootstrap's .nav-link: the folder summary used
           to carry it and picked up the playlist-link rules instead of its own. *@
        @foreach (var folder in folders)
        {
            <details class="tree-folder" open="@IsOpen(folder)" data-folder="@folder.Name"
                     @ontoggle="() => OnToggled(folder)">
                <summary class="tree-row" title="@folder.Name">
                    <span class="tree-icon folder-icon" aria-hidden="true">
                        <svg class="folder-closed" viewBox="0 0 16 16"><path d="M1.5 3.5A1 1 0 0 1 2.5 2.5h3.6l1.5 1.5h5.9a1 1 0 0 1 1 1v7.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1z" /></svg>
                        <svg class="folder-open" viewBox="0 0 16 16"><path d="M1.5 3.5a1 1 0 0 1 1-1h3.6l1.5 1.5h5a1 1 0 0 1 1 1V6H4.3a1 1 0 0 0-.95.68L1.5 12.2z" /><path d="M3.6 7h11.2a.6.6 0 0 1 .57.79l-1.6 4.8a1 1 0 0 1-.95.68H2.2a.4.4 0 0 1-.38-.53z" /></svg>
                    </span>
                    <span class="tree-label">@folder.Name</span>
                    <span class="tree-chevron" aria-hidden="true"></span>
                </summary>
                <div class="folder-children">
                    @foreach (var playlist in folder.Playlists)
                    {
                        <NavLink class="tree-row" href="@($"/playlist/{playlist.Uuid}")" title="@playlist.Name">
                            <span class="tree-icon" aria-hidden="true">♫</span>
                            <span class="tree-label">@playlist.Name</span>
                        </NavLink>
                    }
                </div>
            </details>
        }

        @foreach (var playlist in rootPlaylists)
        {
            <NavLink class="tree-row" href="@($"/playlist/{playlist.Uuid}")" title="@playlist.Name">
                <span class="tree-icon" aria-hidden="true">♫</span>
                <span class="tree-label">@playlist.Name</span>
            </NavLink>
        }

        @if (folders.Count == 0 && rootPlaylists.Count == 0)
        {
            <p class="folder-tree-message">No playlists found.</p>
        }

        <div class="collection-status">
            @if (CollectionService.LastSyncedAt is { } synced)
            {
                <div title="When Drive last received a new collection.nml">
                    Synced @synced.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            }
            @if (CollectionService.LastAdded is { } added)
            {
                <div class="collection-status-added"
                     title="@(added.Title ?? System.IO.Path.GetFileName(added.Path))">
                    Newest: @TrackDate.Format(added.ImportDate) ·
                    @(added.Title ?? System.IO.Path.GetFileName(added.Path))
                </div>
            }
        </div>
    }
</nav>

@code {
    List<Folder> folders = [];
    List<Playlist> rootPlaylists = [];
    bool loaded;
    string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            folders = await CollectionService.GetFoldersAsync();
            rootPlaylists = await CollectionService.GetRootPlaylistsAsync();
            await LoadOpenStateAsync();
            ExpandActiveFolder();
            loaded = true;
        }
        catch (DriveAuthException ex)
        {
            Errors.Report("Google rejected the access token", ex);
            await Auth.HandleExpiredAsync();
        }
        catch (Exception ex)
        {
            // Show the real reason. This used to be an unhandled XmlException
            // that blanked the page, because a 404 body was fed to the parser.
            loadError = ex.Message;
            Errors.Report($"Could not load {CollectionService.CollectionFileName}", ex);
            loaded = true;
        }
    }

    // Remembered per folder name (Traktor folders carry no UUID). Only folders
    // in this map deviate from the default; the rest follow folders.Count <= 3.
    const string OpenStateKey = "sidebar-folders:v1";
    Dictionary<string, bool> openState = new(StringComparer.Ordinal);
    IJSObjectReference? memory;

    bool IsOpen(Folder folder) =>
        openState.TryGetValue(folder.Name ?? "", out var open) ? open : folders.Count <= 3;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (ExpandActiveFolder()) InvokeAsync(StateHasChanged);
    }

    /// <summary>Opens the folder holding the playlist in the URL, so a reload never hides it.</summary>
    bool ExpandActiveFolder()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        const string prefix = "/playlist/";
        if (!path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) return false;
        var uuid = path[prefix.Length..];

        var folder = folders.FirstOrDefault(f => f.Playlists.Any(p => p.Uuid == uuid));
        if (folder is null || IsOpen(folder)) return false;
        openState[folder.Name ?? ""] = true;
        return true;
    }

    // The toggle event carries no state, and it also fires when Blazor itself
    // sets the attribute, so read the element rather than flipping a bool.
    async Task OnToggled(Folder folder)
    {
        try
        {
            memory ??= await JS.InvokeAsync<IJSObjectReference>("import", "./remember.js");
            var open = await memory.InvokeAsync<bool?>("folderOpen", folder.Name ?? "");
            // Matching what was rendered means Blazor set it, not the user.
            if (open is null || open == IsOpen(folder)) return;
            openState[folder.Name ?? ""] = open.Value;
            await JS.InvokeVoidAsync("localStorage.setItem", OpenStateKey,
                System.Text.Json.JsonSerializer.Serialize(openState));
        }
        catch { /* storage or module unavailable: the sidebar still works, it just forgets */ }
    }

    async Task LoadOpenStateAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", OpenStateKey);
            if (string.IsNullOrEmpty(raw)) return;
            openState = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, bool>>(raw)
                        ?? new(StringComparer.Ordinal);
        }
        catch { openState = new(StringComparer.Ordinal); } // unreadable or old format: start from defaults
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
