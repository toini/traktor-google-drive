@using TraktorGoogleDrive.Services
@implements IDisposable
@inject DiscoverService Discover

@* What a refresh (or "Add & search") is doing and what it found, per seed, so a
   press is never a silent no-op: progress while it runs, with the request count
   and a time estimate from the server's 2 s spacing, then one line per seed.
   Rendered by RunReport, which a crate's "Find all" shares. *@
@if (Discover.RunOf(Genre) is { } run)
{
    <RunReport Running="run.Running"
               Now="@(run.Detail ?? $"Checking {run.Current}…")"
               Done="@($"{run.Title}, {run.StartedAt.ToLocalTime():HH:mm}: {run.Requests} request{(run.Requests == 1 ? "" : "s")}.")"
               Results="run.Results.Select(r => new RunReport.Line(r.Name, r.Kind.ToString(), r.Text, KindClass(r.Kind))).ToList()">
        <Meter>
            @run.Title · seed @Math.Min(run.Done + 1, run.Total) of @run.Total ·
            <span data-request-count>@run.Requests</span> request@(run.Requests == 1 ? "" : "s") so far ·
            up to about @Eta(DiscoverService.RequestsLeft(run)) left (one Bandcamp request every @DiscoverService.SecondsPerRequest s)
        </Meter>
    </RunReport>
}

@code {
    [Parameter, EditorRequired] public string Genre { get; set; } = "";

    /// <summary>"40 s" or "4 min": requests × the server's spacing.</summary>
    public static string Eta(int requests) => Duration(requests * DiscoverService.SecondsPerRequest);

    public static string Duration(double seconds) =>
        seconds < 90 ? $"{(int)Math.Ceiling(seconds)} s" : $"{(int)Math.Ceiling(seconds / 60.0)} min";

    static string KindClass(DiscoverService.OutcomeKind k) => k switch
    {
        DiscoverService.OutcomeKind.Queued => "good",
        DiscoverService.OutcomeKind.Error or DiscoverService.OutcomeKind.NotAdded => "bad",
        _ => "",
    };

    // Only a string parameter: Blazor would not re-render this on the page's changes.
    protected override void OnInitialized() => Discover.Changed += OnChanged;

    void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Discover.Changed -= OnChanged;
}
