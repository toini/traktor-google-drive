@namespace TraktorGoogleDrive.Components
@using TraktorGoogleDrive.Models
@using TraktorGoogleDrive.Services
@implements IDisposable
@inject PlayerService Player
@inject PlaybackMemory Memory

@if (Player.CurrentFileId is not null || Player.PreviewActive)
{
    <div class="player-bar @(Player.PreviewActive ? "previewing" : "")" role="region" aria-label="Now playing">
        <div class="player-transport">
            <button class="player-step" title="Previous track" aria-label="Previous track"
                    disabled="@(!Player.HasQueue)" @onclick="Player.PreviousAsync">⏮</button>
            <button class="player-toggle @(Player.State == PlaybackState.Playing ? "playing" : "")"
                    title="@(Player.State == PlaybackState.Playing ? "Pause" : "Play")"
                    aria-label="@(Player.State == PlaybackState.Playing ? "Pause" : "Play")"
                    @onclick="Toggle">
                @if (Player.State == PlaybackState.Loading)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
                else
                {
                    <span aria-hidden="true">@(Player.State == PlaybackState.Playing ? "❚❚" : "▶")</span>
                }
            </button>
            <button class="player-step" title="Next track" aria-label="Next track"
                    disabled="@(!Player.HasQueue)" @onclick="Player.NextAsync">⏭</button>
        </div>

        <div class="player-body">
            <div class="player-title">
                @if (Player.PreviewActive)
                {
                    <span class="player-preview-chip" data-preview-chip
                          title="Gig preview: each track plays from its load cue to the end of its last loop">
                        PREVIEW · @Player.QueuePosition/@Player.QueueCount
                    </span>
                }
                else if (Player.PreviewStoppedReason is { } why)
                {
                    @* Preview never just vanishes: when it ends on its own, say why. *@
                    <span class="player-preview-stopped" data-preview-stopped role="status">Preview stopped: @why</span>
                }
                @(Player.CurrentTitle ?? "…")
                @if (Player.IsCasting)
                {
                    <span class="player-output">▶ @(Player.CastDeviceName ?? "TV")</span>
                }
                @if (Player.PreviewActive && Player.CurrentRange is { } range)
                {
                    <span class="player-preview-range" data-preview-range
                          data-start="@range.Start.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          data-end="@(range.End?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">@range.Describe()</span>
                }
            </div>

            @if (Player.CurrentFile is { } file && Player.CurrentFile.DriveFileId == Player.CurrentFileId)
            {
                <Waveform File="@file" Url="@Player.CurrentUrl" Casting="@Player.IsCasting"
                          Range="@(Player.PreviewActive ? Player.CurrentRange : null)" />
            }
            else
            {
                <input class="player-seek" type="range" min="0" max="1000" step="1"
                       value="@((int)(Fraction * 1000))"
                       aria-label="Seek"
                       @onchange="OnSeekInput" />
            }
        </div>

        @if (Player.NeedsSignIn)
        {
            <div class="player-signin" role="alert" data-player-signin>
                <span>Paused — your Google session expired.</span>
                <button class="player-signin-button" data-player-signin-button @onclick="Player.SignInToContinueAsync">
                    Sign in again to continue
                </button>
            </div>
        }

        <div class="player-time">
            <span>@TrackTime.Position(Player.CurrentTime)</span>
            <span class="player-time-sep">/</span>
            <span>@TrackTime.Format(Player.Duration)</span>
        </div>

        <div class="player-modes">
            <label class="player-continuous" title="When a track ends, play the next row in the table">
                <input type="checkbox" checked="@Player.ContinuousPlay" data-continuous-play
                       @onchange="OnContinuousChanged" />
                Continuous
            </label>
            @if (Player.PreviewActive)
            {
                <button class="player-preview-stop" data-stop-preview @onclick="Player.StopPreview">✕ Stop preview</button>
            }
        </div>
    </div>
}

@code {
    double Fraction => Player.Duration > 0 ? Math.Clamp(Player.CurrentTime / Player.Duration, 0, 1) : 0;

    protected override void OnInitialized() => Player.Changed += OnChanged;

    protected override Task OnInitializedAsync() => Player.LoadPreferencesAsync();

    // After render, not in OnInitialized: restoring awaits Drive, and the bar
    // should not hold up the first paint of the page for it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Memory.RestoreAsync();
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    async Task Toggle()
    {
        if (Player.State == PlaybackState.Playing) await Player.PauseAsync();
        else await Player.ResumeAsync();
    }

    Task OnContinuousChanged(ChangeEventArgs e) => Player.SetContinuousPlayAsync(e.Value is true);

    async Task OnSeekInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var thousandths))
            await SeekToFraction(thousandths / 1000.0);
    }

    async Task SeekToFraction(double fraction)
    {
        if (Player.Duration > 0) await Player.SeekAsync(fraction * Player.Duration);
    }

    public void Dispose() => Player.Changed -= OnChanged;
}
