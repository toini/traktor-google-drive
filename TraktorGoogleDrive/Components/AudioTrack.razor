@namespace TraktorGoogleDrive.Components
@using Microsoft.JSInterop
@using TraktorGoogleDrive.Models
@using TraktorGoogleDrive.Services
@implements IDisposable
@inject PlayerService Player

<button class="play-button @StateClass"
        data-drive-file-id="@File?.DriveFileId"
        data-state="@StateClass"
        title="@(IsPlaying ? "Pause" : "Play") @(File?.Track?.Title)"
        aria-label="@(IsPlaying ? "Pause" : "Play") @(File?.Track?.Title)"
        @onclick="Toggle"
        disabled="@(File is null || string.IsNullOrEmpty(File.DriveFileId))">
    @if (IsLoading)
    {
        <span class="play-icon spinner" aria-hidden="true"></span>
    }
    else if (IsPlaying)
    {
        <span class="play-icon" aria-hidden="true">❚❚</span>
    }
    else
    {
        <span class="play-icon" aria-hidden="true">▶</span>
    }
</button>

@code {
    [Parameter] public FileEntry? File { get; set; }
    [Parameter] public string? Token { get; set; }

    bool IsPlaying => File is not null && Player.IsPlaying(File);
    bool IsLoading => File is not null && Player.IsLoading(File);

    string StateClass => IsLoading ? "loading" : IsPlaying ? "playing" : "idle";

    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    // Changed fires every second while anything plays (the progress), and a
    // playlist has a button per row: re-render only the ones whose own state moved.
    string? renderedState;

    void OnPlayerChanged()
    {
        if (StateClass != renderedState) InvokeAsync(StateHasChanged);
    }

    protected override void OnAfterRender(bool firstRender) => renderedState = StateClass;

    async Task Toggle()
    {
        if (File is null || string.IsNullOrEmpty(File.DriveFileId) || string.IsNullOrEmpty(Token))
            return;

        // The service derives url/title/format from the entry, and routes to the
        // TV when a Cast session is up, so this button stays output-agnostic.
        await Player.ToggleAsync(File, Token);
    }

    public void Dispose() => Player.Changed -= OnPlayerChanged;
}
