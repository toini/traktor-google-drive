@namespace TraktorGoogleDrive.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject TraktorGoogleDrive.Services.AppErrors Errors

<div class="waveform @(failed ? "failed" : "")">
    <canvas @ref="canvas" class="waveform-canvas" @onclick="OnClick"></canvas>

    @if (progress is { } p && peaks is null && !failed)
    {
        <div class="waveform-status">Sampling waveform… @((int)(p * 100))%</div>
    }
    else if (failed)
    {
        <div class="waveform-status">Waveform unavailable</div>
    }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? FileId { get; set; }
    [Parameter] public double Position { get; set; }
    [Parameter] public EventCallback<double> OnSeek { get; set; }

    ElementReference canvas;
    IJSObjectReference? module;
    DotNetObjectReference<Waveform>? self;
    double[]? peaks;
    double? progress;
    bool failed;
    string? loadedFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrEmpty(Url) || string.IsNullOrEmpty(FileId)) return;

        if (loadedFor != FileId)
        {
            loadedFor = FileId;
            peaks = null;
            progress = 0;
            failed = false;
            await LoadAsync(FileId, Url);
            return;
        }

        if (peaks is not null && module is not null)
            await module.InvokeVoidAsync("draw", canvas, peaks, Position);
    }

    async Task LoadAsync(string fileId, string url)
    {
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./waveform.js");
            self ??= DotNetObjectReference.Create(this);

            peaks = await module.InvokeAsync<double[]>("computePeaks", url, fileId, self);
            progress = null;
            StateHasChanged();
            await module.InvokeVoidAsync("draw", canvas, peaks, Position);
        }
        catch (Exception ex)
        {
            // A missing waveform must not break playback, so this is a notice.
            failed = true;
            progress = null;
            Errors.Info("Could not build a waveform for this recording", ex.Message);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnPeakProgress(double fraction)
    {
        progress = fraction;
        InvokeAsync(StateHasChanged);
    }

    async Task OnClick(MouseEventArgs e)
    {
        if (module is null || peaks is null) return;
        var fraction = await module.InvokeAsync<double>("fractionFromClick", canvas, e.ClientX);
        await OnSeek.InvokeAsync(fraction);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit gone during teardown */ }
        }
        self?.Dispose();
    }
}
