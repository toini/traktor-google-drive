@namespace TraktorGoogleDrive.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject TraktorGoogleDrive.Services.PlayerService Player
@inject TraktorGoogleDrive.Services.AppErrors Errors

<div class="waveform @(failed ? "failed" : "")">
    <div @ref="container" class="waveform-canvas"></div>

    @if (progress is { } p && !mounted && !failed)
    {
        <div class="waveform-status">Sampling waveform… @((int)(p * 100))%</div>
    }
    else if (failed)
    {
        <div class="waveform-status">Waveform unavailable</div>
    }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? FileId { get; set; }

    ElementReference container;
    IJSObjectReference? module;
    IJSObjectReference? media;
    DotNetObjectReference<Waveform>? self;
    double? progress;
    bool mounted;
    bool failed;
    string? loadedFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrEmpty(Url) || string.IsNullOrEmpty(FileId)) return;
        if (loadedFor == FileId) return;

        loadedFor = FileId;
        mounted = false;
        progress = 0;
        failed = false;
        await LoadAsync(FileId, Url);
    }

    async Task LoadAsync(string fileId, string url)
    {
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./waveform.js");
            self ??= DotNetObjectReference.Create(this);

            var peaks = await module.InvokeAsync<double[]>("computePeaks", url, fileId, self);
            progress = null;

            media = await Player.MediaElementAsync();
            if (media is null) throw new InvalidOperationException("no media element to attach to");

            // Traktor's PLAYTIME, because a sliced 206 response can leave the
            // element's own duration unknown for a long while.
            await module.InvokeVoidAsync("mount", container, media, peaks, Player.Duration);
            mounted = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // A missing waveform must never stop playback, so this is a notice.
            failed = true;
            progress = null;
            Errors.Info("Could not build a waveform for this recording", ex.Message);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnPeakProgress(double fraction)
    {
        progress = fraction;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("destroy");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit gone during teardown */ }
        }
        if (media is not null)
        {
            try { await media.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        self?.Dispose();
    }
}
