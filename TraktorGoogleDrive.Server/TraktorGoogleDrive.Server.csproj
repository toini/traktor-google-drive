<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TraktorGoogleDrive.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Without this the server serves nothing until publish.sh hand-copies
         wwwroot, so `dotnet run` on the server project looked broken. -->
    <ProjectReference Include="..\TraktorGoogleDrive\TraktorGoogleDrive.csproj" />
  </ItemGroup>

</Project>
